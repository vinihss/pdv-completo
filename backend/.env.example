# ============================================================
# Variáveis de ambiente — ver 01-backend-spec.md §14.1
# Copie para .env e ajuste conforme o modo de implantação.
# ============================================================

# "local" (mini-PC/NUC via Docker, Postgres no compose) ou "cloud"
# (Postgres gerenciado). O banco é Postgres nos dois modos — o SQLite foi
# removido.
DEPLOYMENT_MODE=local

# Obrigatória, sempre postgres:// ou postgresql://.
# Com Docker Compose: postgres://pdv:pdv_password@postgres:5432/pdv
# Em dev fora do Docker:  postgres://pdv:pdv_password@localhost:5432/pdv
DATABASE_URL=postgres://pdv:pdv_password@localhost:5432/pdv

# Conexões simultâneas no pool (o backend é o único cliente do Postgres)
DATABASE_POOL_MAX=10

# ============================================================
# Postgres
# ============================================================
POSTGRES_USER=pdv
POSTGRES_PASSWORD=pdv_password
POSTGRES_DB=pdv
# Host do Postgres (nome do serviço no Docker Compose ou IP/host externo)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Segredo usado para assinar os JWT — gere um valor aleatório forte em produção
# (ex: openssl rand -hex 32). NUNCA reaproveite o valor de exemplo.
JWT_SECRET=troque-este-valor-em-producao

# Restringe quem pode chamar a API pelo browser (CORS). Deixe vazio em dev
# (libera geral). Em produção, defina com o domínio real do frontend —
# várias origens separadas por vírgula, se precisar.
# ex: CORS_ORIGIN=https://app.seudominio.com.br
CORS_ORIGIN=

PORT=3000
LOG_LEVEL=info

# ============================================================
# Multi-tenant (Fase 1 — docs/15-multi-tenant-schema.md)
# ============================================================
# Schema de onde o processo fala SEM roteamento por subdomínio. Hoje é `public`
# (uma loja só); vira `tenant_<slug>` no cutover do §6.2. O registry
# (`public.tenant`) nunca aparece aqui: o nome do schema vem do registry, nunca
# do request.
DEFAULT_TENANT_SCHEMA=public

# Roteamento por `Host`: `true` liga a resolução de loja por subdomínio/domínio
# próprio. PADRÃO É DESLIGADO de propósito (Fase 1): o registry começa vazio e,
# ligado, qualquer endereço não cadastrado levaria 404 — derrubando as lojas que
# já estão no ar. Desligado, o comportamento é idêntico ao de hoje. Ligue só
# depois de popular o registry e ter a Fase 2/3 no ar. É o kill-switch de
# emergência do §6: `false` faz o backend ignorar o `Host` e atender sempre a
# loja default.
TENANT_ROUTING=false

# Domínio da plataforma — o MESMO `${ROOT_DOMAIN}` do Caddy. É o que separa o
# apex (`seudominio.com.br`) de um subdomínio de loja (`pdv1.seudominio.com.br`):
# num TLD de duas labels os dois têm 3 rótulos, então sem esta env o apex vira
# "slug seudominio" e dá 404. Só é usado quando `TENANT_ROUTING=true`.
PLATFORM_ROOT_DOMAIN=seudominio.com.br

# TTL do cache do registry, em segundos (padrão 60). Só mexa para depurar: mudar
# o registry leva até esse tempo para aparecer no app.
TENANT_REGISTRY_CACHE_TTL_SECONDS=60

# ============================================================
# Impressão térmica — daemon local (printer/)
# O daemon roda na mesma máquina do backend (mini-PC/NUC) e escuta em
# 127.0.0.1:8080. O backend envia JSON estruturado; o daemon renderiza
# ESC/POS e envia TCP pra impressora. Em Docker, aponte para o host
# (ex: http://172.17.0.1:8080) ou rode o daemon como sidecar.
# ============================================================
PRINTER_DAEMON_URL=http://127.0.0.1:8080

# ============================================================
# Email (SMTP) — provisioning de dispositivos / credenciais
# ============================================================
# Se SMTP_HOST estiver vazio, as tentativas de envio retornam
# {sent:false, reason:"not_configured"} sem derrubar o fluxo.
# A maioria das provedoras aceita SMTP padrão (Gmail, Hostinger, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@seudominio.com.br
