# ============================================================
# Variáveis de ambiente — ver 01-backend-spec.md §14.1
# Copie para .env e ajuste conforme o modo de implantação.
# ============================================================

# "local" (mini-PC/NUC via Docker, Postgres no compose) ou "cloud"
# (Postgres gerenciado). O banco é Postgres nos dois modos — o SQLite foi
# removido.
DEPLOYMENT_MODE=local

# Obrigatória, sempre postgres:// ou postgresql://.
# Com Docker Compose: postgres://pdv:pdv_password@postgres:5432/pdv
# Em dev fora do Docker:  postgres://pdv:pdv_password@localhost:5432/pdv
DATABASE_URL=postgres://pdv:pdv_password@localhost:5432/pdv

# Conexões simultâneas no pool (o backend é o único cliente do Postgres)
DATABASE_POOL_MAX=10

# ============================================================
# Postgres
# ============================================================
POSTGRES_USER=pdv
POSTGRES_PASSWORD=pdv_password
POSTGRES_DB=pdv
# Host do Postgres (nome do serviço no Docker Compose ou IP/host externo)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Segredo usado para assinar os JWT — gere um valor aleatório forte em produção
# (ex: openssl rand -hex 32). NUNCA reaproveite o valor de exemplo.
JWT_SECRET=troque-este-valor-em-producao

# Restringe quem pode chamar a API pelo browser (CORS). Deixe vazio em dev
# (libera geral). Em produção, defina com o domínio real do frontend —
# várias origens separadas por vírgula, se precisar.
# ex: CORS_ORIGIN=https://app.seudominio.com.br
CORS_ORIGIN=

PORT=3000
LOG_LEVEL=info

# ============================================================
# Integração iFood (ver docs/05-ifood-integration.md)
# Credenciais geradas em developer.ifood.com.br (app centralizado →
# client_credentials). IFOOD_MOCK=true ativa um mock local (sem rede)
# para desenvolvimento — ver ifood/mock.ts.
# ============================================================
IFOOD_SYNC_ENABLED=false
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_MERCHANT_ID=
IFOOD_POLLING_INTERVAL_MS=30000
IFOOD_MOCK=false
IFOOD_MOCK_PORT=3999
IFOOD_BASE_URL=https://merchant-api.ifood.com.br

# ============================================================
# WhatsApp Cloud API — Embedded Signup (ver docs/10-whatsapp-embedded-signup.md)
#
# O token NÃO fica aqui: ele é por WABA (por conta conectada) e vive no
# banco, na tabela whatsapp_connection. O que fica no ambiente é o que
# pertence ao APP da Meta — o mesmo para toda loja que se conectar nele.
# ============================================================

# App do Meta (developers.facebook.com) e seu segredo. O segredo troca o
# code do Embedded Signup no servidor e assina o appsecret_proof: nunca
# pode ir para o frontend.
META_APP_ID=
META_APP_SECRET=

# Configuração (config_id) do Embedded Signup v4, criada no painel do app em
# "WhatsApp → Embedded Signup". É ela que declara produtos, assets e as
# permissões que o cliente vai autorizar. Vai para o browser: não é segredo.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# Versão da Graph API e a URL base. A base só muda em teste (a suíte aponta
# para um stub HTTP local; ver test/whatsapp.test.ts).
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# Token de verificação do webhook. Escolha um valor aleatório seu: a Meta
# manda o hub.verify_token no handshake e compara com o que está aqui.
WHATSAPP_VERIFY_TOKEN=

# ---------- Legado (só para instalação que já tinha token colado no env) ----------
# Usado APENAS se não existir nenhuma whatsapp_connection ativa no banco. Deixe
# vazio para usar o Embedded Signup — que é o caminho suportado.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
