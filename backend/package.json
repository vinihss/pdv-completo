{
  "name": "pdv-backend",
  "version": "1.0.0",
  "description": "PDV Backend - restaurante/pub",
  "type": "module",
  "main": "dist/http/server.js",
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/http/server.js",
    "seed": "tsx src/infra/db/seed.ts",
    "seed:prod": "tsx src/infra/db/seed-prod.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infra/db/migrate.ts",
    "db:migrate:sqlite": "tsx src/infra/db/migrate-sqlite-to-pg.ts",
    "db:deactivate-demo": "tsx src/infra/db/deactivate-demo-catalog.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
