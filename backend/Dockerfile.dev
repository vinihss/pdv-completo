# ============================================================
# Backend PDV — imagem de desenvolvimento (hot reload)
# ============================================================
FROM node:22-slim

# Toolchain de build: o `better-sqlite3` (peer dependency OPCIONAL do
# drizzle-orm, marcado `devOptional` no lockfile) tem install script — o npm
# roda o node-gyp e o build estoura sem python3/make/g++. Mesma razão pela
# qual o `backend/Dockerfile` (produção) instala a toolchain. Sem esta linha
# o `npm install` abaixo falha e a imagem de dev não existe.
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Instalar dependências
# `npm ci` (e não `npm install`): o lockfile é o contrato da imagem — sem ele
# a mesma tag pode sair com dependências diferentes em cada build. Testado
# dentro do node:22-slim com a toolchain acima: o `better-sqlite3` compila.
COPY package*.json ./
RUN npm ci

# Copiar código fonte (montado via bind mount em dev)
COPY . .

# Expor porta
EXPOSE 3000

# Sem CMD, o container herdaria `node` da imagem base — que abre o REPL,
# sai imediatamente (exit 0) e entra em restart loop. Em dev, o servidor
# roda com hot reload a partir do código-fonte montado via bind mount.
CMD ["npm", "run", "dev"]
