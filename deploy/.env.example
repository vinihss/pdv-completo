# ============================================================
# Variáveis do deploy em nuvem — copie para .env nesta pasta
# ============================================================

# Domínio real, sem https:// na frente (Caddy cuida do certificado sozinho,
# só precisa que o DNS já aponte pro IP do servidor antes de subir)
DOMAIN=labolabe.tech

# Origens liberadas no CORS, separadas por vírgula e SEM espaços. Vazio usa
# https://${DOMAIN}. Liste aqui todo endereço que SERVE O APP — se faltar um,
# o app carrega mas o navegador bloqueia toda chamada de API, sem erro
# aparecendo no servidor. Endereços que só redirecionam (ex.: o domínio raiz
# apontando pro Instagram) não entram na lista.
#
# Se usa o app desktop (Tauri, ver frontend/src-tauri/build-app.sh), acrescente as duas
# origens dele — sem elas o app abre mas nenhuma chamada de API passa:
#   CORS_ORIGIN=https://restaurante1.labolabe.tech,https://restaurante2.labolabe.tech,https://app.labolabe.tech,https://www.labolabe.tech,tauri://localhost,http://tauri.localhost,tauri://localhost,http://tauri.localhost
CORS_ORIGIN=https://restaurante1.labolabe.tech,https://restaurante2.labolabe.tech,https://app.labolabe.tech,https://www.labolabe.tech,tauri://localhost,http://tauri.localhost

# Gere com: openssl rand -hex 32
# NUNCA reaproveite um valor de exemplo em produção.
JWT_SECRET=

# ============================================================
# Postgres (serviço `postgres` do compose)
# Se usar um Postgres gerenciado, ignore o serviço do compose e ajuste
# só o DATABASE_URL para o endpoint externo.
# ============================================================
POSTGRES_USER=pdv
POSTGRES_PASSWORD=
POSTGRES_DB=pdv

# Se o compose sobe o Postgres, o padrão já aponta pro serviço; com um
# Postgres externo, sobrescreva (ex: postgres://user:pass@host:5432/pdv).
# DATABASE_URL=

# Quando true, usa a chave de teste (sandbox) do Pagar.me.
PAGARME_TEST_MODE=false

# Chave da API do Pagar.me (sandbox se PAGARME_TEST_MODE=true).
PAGARME_API_KEY=

# Secret usado para validar webhooks do Pagar.me (HMAC SHA256).
PAGARME_WEBHOOK_SECRET=

# Recipient padrão da plataforma (recebe split %).
PLATFORM_PAGARME_RECIPIENT_ID=

# Conexões simultâneas no pool do backend
DATABASE_POOL_MAX=10
