# ============================================================
# Caddy — proxy reverso com HTTPS automático (Let's Encrypt).
#
# Domínios:
#   umamisushiarte.com.br      → pedido público do tenant umami (sem login)
#   app.umamisushiarte.com.br  → aplicação interna (backend + frontend PDV)
#   api.umamisushiarte.com.br  → API pública (com header X-Tenant-Host)
#   *.seudominio.com.br        → pedido público multi-tenant (subdomínio)
#
# Os três blocos do meio saem de `{$ROOT_DOMAIN}` (ver `environment` do
# serviço `caddy` e `ROOT_DOMAIN` no .env.example), que vale
# `umamisushiarte.com.br`: com esse valor `app.{$ROOT_DOMAIN}` É o
# `app.umamisushiarte.com.br` que está no ar hoje, e o wildcard
# `*.{$ROOT_DOMAIN}` não colide com o `*.labolabe.tech` do fim do arquivo.
#
# A sintaxe de variável do Caddy é `{$VAR}` — `${VAR}` NÃO é env: no
# Caddyfile o `${...}` é substituição de ARGUMENTO de placeholder em
# diretiva, e o resultado é o erro `subject does not qualify for
# certificate: 'app.{$ROOT_DOMAIN}'` no `caddy validate`.
#
# Todos precisam de registro DNS tipo A apontando para o IP do
# servidor, senão o Let's Encrypt não consegue validar o desafio
# HTTP-01 e nenhum certificado é emitido (o Caddy fica servindo
# apenas HTTP). Ver a seção "DNS obrigatório" do deploy/README.md.
# ============================================================

{
	on_demand_tls {
		# O Caddy só emite cert sob demanda se este endpoint liberar o domínio.
		ask http://{$PDV_BACKEND_UPSTREAM:backend:3000}/internal/caddy-on-demand-tls
	}
}

# Rotas da aplicação, compartilhadas pelos sites que servem o PDV.
# `handle` faz o roteamento por caminho; o resto vai pro frontend.
(site) {
	# API REST
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy {$PDV_BACKEND_UPSTREAM:backend:3000}
	}

	# WebSocket em tempo real
	handle /realtime* {
		reverse_proxy {$PDV_WS_UPSTREAM:backend:3000} {
			stream_close_delay 5m
		}
	}

	# Fotos de produto servidas pelo backend
	handle /uploads/* {
		reverse_proxy {$PDV_BACKEND_UPSTREAM:backend:3000}
	}

	# ---------- Auto-update do app desktop ----------
	handle /updates/desktop/*/*/* {
		rewrite * /latest.json
		file_server {
			root /srv/pdv-updates
		}
	}

	handle /updates/caixa/*/*/* {
		rewrite * /caixa/latest.json
		file_server {
			root /srv/pdv-updates
		}
	}

	handle /updates/kds/*/*/* {
		rewrite * /kds/latest.json
		file_server {
			root /srv/pdv-updates
		}
	}

	handle /updates/files/* {
		uri strip_prefix /updates/files
		file_server {
			root /srv/pdv-updates/files
		}
	}

	# ---------- Webhook do Pagar.me ----------
	handle /webhooks/pagarme* {
		reverse_proxy {$PDV_PAGARME_UPSTREAM:backend:3000}
	}

	# Webhooks da Meta (WhatsApp Cloud API)
	handle /webhooks/* {
		reverse_proxy {$PDV_BACKEND_UPSTREAM:backend:3000}
	}

	# Health check direto
	handle /health {
		reverse_proxy {$PDV_BACKEND_UPSTREAM:backend:3000}
	}

	# ---------- Canal interno: recusar na borda ----------
	handle /internal/* {
		respond 404
	}

	# Resto: frontend estático (PWA)
	handle {
		reverse_proxy {$PDV_FRONTEND_UPSTREAM:frontend:80}
	}

	encode gzip
}

# ---------- Bloco 1: Aplicação interna do PDV (app.*) ----------
# Mantém o app interno (garçom/cozinha/gerente/caixa) em app.ROOT_DOMAIN
# IMPORTANTE: este bloco DEVE vir ANTES do wildcard *.ROOT_DOMAIN
# para que o Caddy faça o match correto (especificidade > wildcard)
app.{$ROOT_DOMAIN} {
	import site
}

# ---------- Bloco 2: API pública com contexto de tenant ----------
# Injeta header X-Tenant-Host para o backend identificar o tenant
api.{$ROOT_DOMAIN} {
    encode gzip zstd
    header {
        Access-Control-Allow-Origin https://*.{$ROOT_DOMAIN} https://app.{$ROOT_DOMAIN} https://umamisushiarte.com.br https://www.umamisushiarte.com.br
        Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization, X-Tenant-Slug, X-Tenant-Host, X-Forwarded-Host"
        Access-Control-Allow-Credentials true
        defer
    }

    @options method OPTIONS
    respond @options 204

    # Upstream pelo PONTEIRO, como todo proxy de backend nesta Caddyfile — e
    # não o literal `backend:3000`. O switch para a instância antiga no passo
    # 5, então um literal deixaria a `api.` apontando para um container
    # PARADO a partir do primeiro switch: a rota pública do cardápio passaria
    # a responder 502 enquanto o resto do app (que usa
    # `{$PDV_BACKEND_UPSTREAM}`) continua funcionando — que é o pior tipo de
    # falha, porque o sintoma aparece só no navegador do cliente final e o
    # log do servidor não reclama de nada.
    reverse_proxy {$PDV_BACKEND_UPSTREAM:backend:3000} {
        header_up X-Tenant-Host {host}
        header_up Host {host}
    }
}

# ---------- Bloco 3: Domínio próprio do Umami Sushi Arte ----------
# Acessar https://umamisushiarte.com.br → tela de pedido pública do tenant "umami"
umamisushiarte.com.br {
    # Redirect para WhatsApp
    redir https://wa.me/5551997506070?type=phone_number&app_absent=0 302
    encode gzip zstd
    reverse_proxy pedidopublic:80
}

www.umamisushiarte.com.br {
    redir https://umamisushiarte.com.br{uri} permanent
}

# ---------- Bloco 4: Wildcard para demais tenants (subdomínio) ----------
# Qualquer subdomínio de ROOT_DOMAIN (exceto app, api, www) cai no pedido público
*.{$ROOT_DOMAIN} {
    encode gzip zstd
    reverse_proxy pedidopublic:80
}

# ============================================================
# ---------- Wildcard *.labolabe.tech (legacy) ----------
#
# TODO subdomínio de *.labolabe.tech cai no mesmo bloco e serve a mesma app.
#
# TLS: on-demand — na primeira requisição TLS de um subdomínio novo,
# o Caddy pede um certificado específico (HTTP-01) e passa a servi-lo.
# Por isso é OBRIGATÓRIO um registro DNS A coringa `*.labolabe.tech`
# apontando para este servidor; sem ele o ACME não consegue validar.
#
# O wildcard de UMA label: `*.labolabe.tech` cobre `foo.labolabe.tech`,
# mas não `foo.bar.labolabe.tech`.
# ============================================================
*.labolabe.tech {
	import site
	tls {
		on_demand
	}
}
