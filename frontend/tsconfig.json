{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Modo de migração gradual: Aceita o código antigo sem dar erro */
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,

    /* Resolução de Módulos ideal para o Vite 8 / Rolldown */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Mapeamento de caminhos (para resolver o @/ que você usa no app) */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}

