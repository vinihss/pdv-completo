{
  "name": "mobile",
  "version": "0.1.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-dev-client": "^57.0.19",
    "expo-device": "~57.0.2",
    "expo-keep-awake": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "start:garcon": "APP_VARIANT=garcon expo start",
    "start:entregador": "APP_VARIANT=entregador expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "lint": "expo lint",
    "config:garcon": "APP_VARIANT=garcon expo config --type public",
    "config:entregador": "APP_VARIANT=entregador expo config --type public"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^14.0.1",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "babel-preset-expo": "~57.0.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "roots": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-native-mmkv$": "<rootDir>/__mocks__/react-native-mmkv.js",
      "^@react-native-community/netinfo$": "<rootDir>/__mocks__/@react-native-community/netinfo.js",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/@react-native-async-storage/async-storage.js"
    }
  }
}
