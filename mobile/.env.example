# Variante do app: garcon | entregador (padrão: garcon)
APP_VARIANT=garcon

# Google Maps API Key (Android) — necessária APENAS para o app Entregador em
# build de release (APK/AAB). Sem ela o mapa fica cinza no Android.
# iOS usa Apple Maps e não precisa. Vazio em dev/preview é aceitável.
GOOGLE_MAPS_API_KEY=
