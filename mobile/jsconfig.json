{
  // Alias `@/*` → `src/*`. O Metro/Expo já suporta paths de tsconfig/jsconfig
  // por padrão (tsconfigPaths), então só precisamos declarar; o JEST usa o
  // mesmo mapa via moduleNameMapper (ver package.json).
  "compilerOptions": {
    "module": "commonjs",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".expo"]
}