{
  "$schema": "../frontend/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KDS Cozinha",
  "version": "0.1.0",
  "identifier": "com.pdvapp.kds",
  "build": {
    "frontendDist": "../frontend/dist/kds",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../frontend && npm run dev:kds",
    "beforeBuildCommand": "cd ../frontend && npm run build:kds"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KDS Cozinha",
        "width": 1280,
        "height": 800,
        "center": false,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
