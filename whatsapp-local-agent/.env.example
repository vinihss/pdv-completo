# API base da instalação do PDV, incluindo /api e host da loja/tenant
PDV_API_BASE_URL=https://api.sua-loja.exemplo/api

# URL pública do cardápio online
PDV_PUBLIC_ORDER_URL=https://sua-loja.exemplo/pedido

# Opcional: porta do painel local
PDV_WA_PORT=8765

# Opcional: contato individual de teste, apenas dígitos com DDI.
# Configurado, ele é conferido a cada 10 s mesmo sem não lidas/atividade recente.
# Não coloque telefone pessoal neste arquivo de exemplo versionado.
PDV_WA_TEST_PHONE=
