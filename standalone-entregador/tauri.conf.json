{
  "$schema": "../frontend/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PDV Entregador",
  "version": "0.1.0",
  "identifier": "com.pdvapp.entregador",
  "build": {
    "frontendDist": "../frontend/dist/entregador",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../frontend && npm run dev:entregador",
    "beforeBuildCommand": "cd ../frontend && npm run build:entregador"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDV Entregador",
        "width": 412,
        "height": 892,
        "center": true,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
